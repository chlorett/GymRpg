<Window x:Class="MyApp.Wpf.Views.AccountAffiliationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:AccountAffiliationViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Мій зал та дивізіон — PulseForge" Height="720" Width="480"
        MinHeight="620" MinWidth="440"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CollapsedWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource FieldError}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuccessText" TargetType="TextBlock" BasedOn="{StaticResource CollapsedWhenEmpty}">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Мій зал та дивізіон"
                       Margin="0,0,0,12"
                       Style="{StaticResource FormTitle}" />

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10,16,14"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Поточна приналежність" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Нікнейм" Style="{StaticResource CardCaption}" />
                    <TextBlock Text="{Binding CardUsername}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="Регіон" Style="{StaticResource CardCaption}" />
                    <TextBlock Text="{Binding CardRegion}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="Спортзал" Style="{StaticResource CardCaption}" />
                    <TextBlock Text="{Binding CardGym}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="Дивізіон" Style="{StaticResource CardCaption}" />
                    <TextBlock Text="{Binding CardDivision}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="Атлетів у цьому залі" Style="{StaticResource CardCaption}" />
                    <TextBlock Text="{Binding CardMembers}" Style="{StaticResource CardValue}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Нікнейм" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldInput}" />
            <TextBlock Text="{Binding UsernameError}" Style="{StaticResource CollapsedWhenEmpty}" />

            <TextBlock Text="Регіон" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Regions}"
                      SelectedItem="{Binding SelectedRegion}"
                      DisplayMemberPath="Name"
                      Style="{StaticResource FieldInput}" />

            <TextBlock Text="Спортзал" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding AvailableGyms}"
                      SelectedItem="{Binding SelectedGym}"
                      DisplayMemberPath="Name"
                      Style="{StaticResource FieldInput}" />
            <TextBlock Text="{Binding GymError}" Style="{StaticResource CollapsedWhenEmpty}" />

            <TextBlock Text="Дивізіон" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Divisions}"
                      SelectedItem="{Binding SelectedDivision}"
                      DisplayMemberPath="Name"
                      Style="{StaticResource FieldInput}" />
            <TextBlock Text="{Binding DivisionError}" Style="{StaticResource CollapsedWhenEmpty}" />

            <TextBlock Text="{Binding GeneralError}"
                       FontWeight="SemiBold"
                       Margin="0,12,0,0"
                       Style="{StaticResource CollapsedWhenEmpty}" />
            <TextBlock Text="{Binding SuccessMessage}"
                       FontWeight="SemiBold"
                       Margin="0,12,0,0"
                       Style="{StaticResource SuccessText}" />

            <Button Content="Зберегти зміни"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Margin="0,20,0,0"
                    Padding="16,10"
                    FontSize="15"
                    FontWeight="Bold"
                    Style="{StaticResource PrimaryButton}" />

            <Button Content="Скинути"
                    Command="{Binding ResetCommand}"
                    Margin="0,10,0,0"
                    Style="{StaticResource SecondaryButton}" />
        </StackPanel>
    </ScrollViewer>
</Window>
