<Window x:Class="MyApp.Wpf.Views.GymStandingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:GymStandingsViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Рейтинг спортзалів та клуби — PulseForge"
        Height="720" Width="960"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CollapsedWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource FieldError}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuccessText" TargetType="TextBlock" BasedOn="{StaticResource CollapsedWhenEmpty}">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Рейтинг спортзалів та клуби"
                       Style="{StaticResource FormTitle}"
                       Margin="0" />
            <TextBlock Text="{Binding Summary}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Фільтри -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Регіон" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Regions}"
                          SelectedItem="{Binding FilterRegion}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource FieldComboBox}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Дивізіон" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Divisions}"
                          SelectedItem="{Binding FilterDivision}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource FieldComboBox}" />
            </StackPanel>

            <Button Grid.Column="4"
                    Content="Скинути фільтри"
                    Command="{Binding ResetFiltersCommand}"
                    VerticalAlignment="Bottom"
                    Padding="16,8"
                    Style="{StaticResource SecondaryButton}" />
        </Grid>

        <!-- Таблиця клубного рейтингу -->
        <GroupBox Grid.Row="2"
                  Header="Міжклубний рейтинг"
                  Padding="8"
                  Margin="0,8,0,12">
            <DataGrid ItemsSource="{Binding Standings}"
                      Style="{StaticResource AppDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Місце"
                                        Binding="{Binding Rank, StringFormat=#{0}}"
                                        Width="70" />
                    <DataGridTextColumn Header="Спортзал"
                                        Binding="{Binding GymName}"
                                        Width="1.6*" />
                    <DataGridTextColumn Header="Регіон"
                                        Binding="{Binding RegionName}"
                                        Width="1.3*" />
                    <DataGridTextColumn Header="Атлетів"
                                        Binding="{Binding ActiveAthletes}"
                                        Width="80" />
                    <DataGridTextColumn Header="Сумарний XP"
                                        Binding="{Binding TotalXp}"
                                        Width="110" />
                    <DataGridTextColumn Header="Сер. XP"
                                        Binding="{Binding AverageXp}"
                                        Width="90" />
                    <DataGridTextColumn Header="Лідер клубу"
                                        Binding="{Binding LeaderNickname}"
                                        Width="1.2*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Реєстрація нового спортзалу: лише для тренера й адміністратора -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10,16,14"
                Margin="0,0,0,8"
                Visibility="{Binding CanRegisterGyms, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Реєстрація нового спортзалу"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Регіон" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Regions}"
                                  SelectedItem="{Binding NewGymRegion}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FieldComboBox}" />
                        <TextBlock Text="{Binding RegionError}" Style="{StaticResource CollapsedWhenEmpty}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Назва клубу" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewGymName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}" />
                        <TextBlock Text="{Binding NameError}" Style="{StaticResource CollapsedWhenEmpty}" />
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="Додати спортзал"
                            Command="{Binding AddGymCommand}"
                            VerticalAlignment="Top"
                            Margin="0,22,0,0"
                            Padding="16,8"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Повідомлення та кнопки -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding GeneralError}"
                           FontWeight="SemiBold"
                           Style="{StaticResource CollapsedWhenEmpty}" />
                <TextBlock Text="{Binding SuccessMessage}"
                           FontWeight="SemiBold"
                           Style="{StaticResource SuccessText}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Оновити рейтинг"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8"
                        Margin="0,0,10,0" />
                <Button Content="Закрити"
                        Click="OnCloseClick"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,8" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
