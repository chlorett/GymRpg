<Window x:Class="MyApp.Wpf.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:ChangePasswordViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Зміна пароля — PulseForge" Height="600" Width="460"
        MinHeight="560" MinWidth="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CollapsedWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource FieldError}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Зміна пароля"
                       Margin="0,0,0,8"
                       Style="{StaticResource FormTitle}" />

            <TextBlock Text="{Binding UserInfo}"
                       Foreground="#718096"
                       FontSize="12"
                       Margin="0,0,0,8" />

            <TextBlock Text="Поточний пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="CurrentPasswordInput"
                         PasswordChanged="OnCurrentPasswordChanged"
                         Style="{StaticResource FieldInput}" />
            <TextBlock Text="{Binding CurrentPasswordError}" Style="{StaticResource CollapsedWhenEmpty}" />

            <TextBlock Text="Новий пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="NewPasswordInput"
                         PasswordChanged="OnNewPasswordChanged"
                         Style="{StaticResource FieldInput}" />
            <TextBlock Text="{Binding NewPasswordError}" Style="{StaticResource CollapsedWhenEmpty}" />

            <TextBlock Text="Підтвердіть новий пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ConfirmNewPasswordInput"
                         PasswordChanged="OnConfirmNewPasswordChanged"
                         Style="{StaticResource FieldInput}" />
            <TextBlock Text="{Binding ConfirmNewPasswordError}" Style="{StaticResource CollapsedWhenEmpty}" />

            <TextBlock Text="Новий пароль: від 8 символів, не більше 72 байтів."
                       Style="{StaticResource StatusText}" />

            <TextBlock Text="{Binding ErrorMessage}"
                       FontWeight="SemiBold"
                       Margin="0,12,0,0"
                       Style="{StaticResource CollapsedWhenEmpty}" />

            <Button Content="Зберегти пароль"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Margin="0,20,0,0"
                    Padding="16,10"
                    FontSize="15"
                    FontWeight="Bold"
                    Style="{StaticResource PrimaryButton}" />

            <Button Content="Скасувати"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Margin="0,10,0,0"
                    Style="{StaticResource SecondaryButton}" />
        </StackPanel>
    </ScrollViewer>
</Window>
