<Window x:Class="MyApp.Wpf.Views.SessionExecutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SessionExecutionViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Проведення тренування — PulseForge"
        Height="720" Width="860"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WorkoutName}"
                       Style="{StaticResource FormTitle}"
                       Margin="0" />
            <TextBlock Text="{Binding ScheduledDateText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13"
                       Margin="0,4,0,0" />
            <TextBlock Text="Вкажіть повторення та вагу для кожного виконаного підходу. Порожні підходи буде пропущено."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- План вправ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Exercises}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ExecutionExerciseRow}">
                        <Border Style="{StaticResource CardBorder}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               Style="{StaticResource CardTitle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TargetText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{Binding Technique}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="148" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Підхід"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0" />
                                    <TextBlock Grid.Column="1"
                                               Text="Повтори"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0" />
                                    <TextBlock Grid.Column="2"
                                               Text="Вага, кг"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Sets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ExecutionSetRow}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="148" />
                                                    <ColumnDefinition Width="148" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SetNumber}"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Style="{StaticResource FieldInput}"
                                                         Text="{Binding Reps, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Margin="0,0,8,0" />
                                                <TextBox Grid.Column="2"
                                                         Style="{StaticResource FieldInput}"
                                                         Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Margin="0,0,8,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ Підхід"
                                        Command="{Binding AddSetCommand}"
                                        IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="32"
                                        Padding="12,4"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Повідомлення про результат / помилку -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource SuccessBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Кнопки -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Завершити та зберегти сесію"
                    Command="{Binding CompleteCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Padding="20,8"
                    HorizontalAlignment="Left" />

            <Button Grid.Column="1"
                    Content="Закрити"
                    Click="OnCloseClick"
                    Style="{StaticResource SecondaryButton}"
                    Padding="20,8" />
        </Grid>
    </Grid>
</Window>