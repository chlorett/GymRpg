<Window x:Class="MyApp.Wpf.Views.ExerciseCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог вправ"
        Width="900" Height="640"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>

        <!-- Ліва частина: пошук, фільтр, список -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Каталог вправ" Style="{StaticResource FormTitle}" Margin="0,0,0,12"/>

            <TextBox Grid.Row="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Пошук за назвою або описом"
                     Padding="6" Margin="0,0,0,8"/>

            <ComboBox Grid.Row="2"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter}"
                      DisplayMemberPath="Label"
                      Style="{StaticResource FieldComboBox}"/>

            <Grid Grid.Row="3">
                <ListBox ItemsSource="{Binding Exercises}"
                         SelectedItem="{Binding SelectedExercise}"
                         DisplayMemberPath="Name"/>
                <TextBlock Text="Вправ не знайдено"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Права частина: деталі вправи (користувач) або форма керування (тренер / адмін) -->
        <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" Padding="16">
            <Grid>
                <!-- Деталі вправи: лише для звичайного користувача -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanManage}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <TextBlock Text="Оберіть вправу зі списку"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedExercise}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedExercise}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"
                                       TextWrapping="Wrap" Foreground="#C53E17"/>
                            <TextBlock Text="{Binding EquipmentLabel}" Foreground="Gray" Margin="0,4,0,16"/>

                            <TextBlock Text="Опис" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,16"/>

                            <TextBlock Text="Техніка виконання" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Technique}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Форма керування каталогом: лише для Trainer / Admin -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanManage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold"
                                       Foreground="#C53E17" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Нова вправа"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="Редагування вправи"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Content="＋ Нова вправа"
                                    Command="{Binding NewExerciseCommand}"
                                    Padding="10,4"/>
                        </Grid>

                        <TextBlock Text="Назва вправи" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsCreating}"
                                 Padding="6" Margin="0,4,0,12"/>

                        <TextBlock Text="Тип обладнання" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding FormEquipmentOptions}"
                                  SelectedItem="{Binding SelectedFormEquipment}"
                                  DisplayMemberPath="Label"
                                  IsEnabled="{Binding IsCreating}"
                                  Style="{StaticResource FieldComboBox}"
                                  Margin="0,4,0,4"/>

                        <TextBlock Text="Назву й тип обладнання під час редагування змінити не можна."
                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="Короткий опис" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="60" MaxHeight="100"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6" Margin="0,4,0,12"/>

                        <TextBlock Text="Техніка виконання" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FormTechnique, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="100" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6" Margin="0,4,0,12"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B"
                                   TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32"
                                   TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Зберегти вправу"
                                    Command="{Binding SaveExerciseCommand}"
                                    Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="Архівувати"
                                    Command="{Binding ArchiveExerciseCommand}"
                                    Padding="14,6"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
