<Window x:Class="MyApp.Wpf.Views.GymModerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:GymModerationViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Учасники залу та модерація — PulseForge" Height="680" Width="1060"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Учасники залу та модерація"
                       Style="{StaticResource FormTitle}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Перегляд складу спортзалів, фільтрація за дивізіонами та модерація чесної гри (Fair Play) у лідерборді."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" />
        </StackPanel>

        <!-- Фільтри: Зал, Дивізіон, Пошук за нікнеймом -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Спортзал" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Gyms}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding SelectedGymId, Mode=TwoWay}"
                              Style="{StaticResource FieldComboBox}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Дивізіон" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Divisions}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding SelectedDivisionId, Mode=TwoWay}"
                              Style="{StaticResource FieldComboBox}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Пошук за нікнеймом / залом" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}" />
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Скинути"
                        Command="{Binding ResetFiltersCommand}"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Bottom"
                        MinHeight="36"
                        Padding="14,6"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="4"
                        Content="Оновити"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        MinHeight="36"
                        Padding="18,6"/>
            </Grid>
        </Border>

        <!-- Зведена статистика залу -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Усього у списку" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding TotalAthletes}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="3,0">
                <StackPanel>
                    <TextBlock Text="Активні у рейтингу" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding ActiveInLeaderboard}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="3,0">
                <StackPanel>
                    <TextBlock Text="Приховані з лідерборду" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding ExcludedFromLeaderboard}" FontSize="22" FontWeight="Bold" Foreground="#D97706"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Заблоковані акаунти" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding BlockedAthletes}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Таблиця учасників клубу -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Members}"
                  SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                  Style="{StaticResource AppDataGrid}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Нікнейм" Binding="{Binding Nickname}" Width="145"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="90"/>
                <DataGridTextColumn Header="Спортзал" Binding="{Binding GymName}" Width="180"/>
                <DataGridTextColumn Header="Дивізіон" Binding="{Binding DivisionName}" Width="130"/>
                <DataGridTextColumn Header="Рівень" Binding="{Binding Level}" Width="75"/>
                <DataGridTextColumn Header="XP" Binding="{Binding Xp}" Width="85"/>
                <DataGridTextColumn Header="Підозрілі рекорди" Binding="{Binding SuspiciousWorkoutsCount}" Width="140"/>
                <DataGridTextColumn Header="Статус у лідерборді" Binding="{Binding LeaderboardStatusText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель керування обраним атлетом -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{Binding ExcludeButtonText}"
                            Command="{Binding ToggleLeaderboardExclusionCommand}"
                            IsEnabled="{Binding HasSelectedMember}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Padding="16,8"/>
                    <Button Content="{Binding BlockButtonText}"
                            Command="{Binding ToggleBlockStatusCommand}"
                            IsEnabled="{Binding HasSelectedMember}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,8"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
