<Window x:Class="MyApp.Wpf.Views.UserProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:UserProgressViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Профіль та RPG-прогрес атлета - PulseForge"
        Height="640" Width="720"
        MinHeight="520" MinWidth="580"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="RPG-прогрес атлета"
                       Style="{StaticResource FormTitle}"
                       Margin="0" />
            <TextBlock Text="{Binding AthleteHeaderText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Картка рівня та досвіду -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding LevelBadgeText}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding RankTitle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#FFF3EE"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Всього XP: "
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalXp}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}"
                             Minimum="0"
                             Maximum="100"
                             Height="14"
                             Foreground="{StaticResource AccentBrush}"
                             Background="#E2E8F0"
                             Margin="0,4,0,6" />

                <TextBlock Text="{Binding XpBarLabel}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- Зведені показники -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Тренувань виконано"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding WorkoutsCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Загальний тоннаж (кг)"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalVolumeKg, StringFormat={}{0:F1}}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Поточний рівень"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Level}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Історія тренувань -->
        <GroupBox Grid.Row="3"
                  Header="Журнал виконаних тренувань"
                  Padding="8"
                  Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding RecentWorkouts}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      FontSize="13"
                      Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource BorderBrushLight}"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Вправа"
                                        Binding="{Binding ExerciseName}"
                                        Width="2*" />
                    <DataGridTextColumn Header="Підходи"
                                        Binding="{Binding SetsCount}"
                                        Width="75" />
                    <DataGridTextColumn Header="Повторення"
                                        Binding="{Binding TotalReps}"
                                        Width="95" />
                    <DataGridTextColumn Header="Тоннаж (кг)"
                                        Binding="{Binding TotalWeightKg, StringFormat={}{0:F1}}"
                                        Width="100" />
                    <DataGridTextColumn Header="Нараховано XP"
                                        Binding="{Binding XpEarned, StringFormat=+{0} XP}"
                                        Width="115" />
                    <DataGridTextColumn Header="Час запису"
                                        Binding="{Binding RecordedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                        Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Повідомлення про помилку -->
        <TextBlock Grid.Row="4"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource FieldError}"
                   Margin="0,0,0,8" />

        <!-- Кнопки дій -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Оновити дані"
                    Command="{Binding LoadProgressCommand}"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="140" />
            <Button Content="Закрити"
                    Click="OnCloseClick"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="120"
                    Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
