<Window x:Class="MyApp.Wpf.Views.WorkoutTemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:WorkoutTemplatesViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Мої шаблони тренувань — PulseForge"
        Height="680" Width="880"
        MinHeight="560" MinWidth="740"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Мої шаблони тренувань (Workout Templates)"
                       Style="{StaticResource FormTitle}"
                       Margin="0" />
            <TextBlock Text="{Binding TrainerHeaderText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Панель пошуку за назвою шаблону -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldInput}"
                     VerticalContentAlignment="Center"
                     ToolTip="Введіть назву шаблону для пошуку" />

            <Button Grid.Column="2"
                    Content="Знайти"
                    Command="{Binding LoadTemplatesCommand}"
                    IsDefault="True"
                    Padding="16,8"
                    Style="{StaticResource PrimaryButton}" />

            <Button Grid.Column="4"
                    Content="Скинути"
                    Command="{Binding ClearSearchCommand}"
                    Padding="14,8"
                    Style="{StaticResource SecondaryButton}" />
        </Grid>

        <!-- Основна область: список шаблонів ліворуч та деталі праворуч -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.45*" />
            </Grid.ColumnDefinitions>

            <!-- Список шаблонів -->
            <GroupBox Grid.Column="0"
                      Header="Збережені програми"
                      Padding="8">
                <DataGrid ItemsSource="{Binding Templates}"
                          SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          FontSize="13"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrushLight}"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва шаблону"
                                            Binding="{Binding Name}"
                                            Width="1.6*" />
                        <DataGridTextColumn Header="Вправ"
                                            Binding="{Binding ExercisesCount}"
                                            Width="65" />
                        <DataGridTextColumn Header="Підходів"
                                            Binding="{Binding TotalSetsCount}"
                                            Width="75" />
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding CreatedAtText}"
                                            Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Деталі обраного шаблону -->
            <GroupBox Grid.Column="2"
                      Header="Структура обраного шаблону"
                      Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTemplateTitleText}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding SelectedTemplateMetaText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedTemplateDescriptionText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedExercises}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              FontSize="13"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrushLight}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№"
                                                Binding="{Binding Position}"
                                                Width="45" />
                            <DataGridTextColumn Header="Вправа"
                                                Binding="{Binding ExerciseName}"
                                                Width="1.6*" />
                            <DataGridTextColumn Header="Інвентар"
                                                Binding="{Binding EquipmentTypeText}"
                                                Width="1.2*" />
                            <DataGridTextColumn Header="Підходи × Повтори"
                                                Binding="{Binding SchemeText}"
                                                Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Повідомлення про статус / помилку -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#2F855A"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Кнопки дій -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="+ Створити новий шаблон"
                    Click="OnCreateNewTemplateClick"
                    Style="{StaticResource PrimaryButton}"
                    Padding="16,8" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Видалити шаблон"
                        Command="{Binding DeleteTemplateCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8"
                        Margin="0,0,10,0" />
                <Button Content="Оновити"
                        Command="{Binding LoadTemplatesCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8"
                        Margin="0,0,10,0" />
                <Button Content="Закрити"
                        Click="OnCloseClick"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,8" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
