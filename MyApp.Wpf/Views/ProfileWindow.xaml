<Window x:Class="MyApp.Wpf.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профіль"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Профіль" Style="{StaticResource FormTitle}" />

        <TextBlock Text="Вага, кг" Margin="0,12,0,2" />
        <TextBox Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding WeightError}" Foreground="Red" TextWrapping="Wrap" />

        <TextBlock Text="Зріст, см" Margin="0,8,0,2" />
        <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding HeightError}" Foreground="Red" TextWrapping="Wrap" />

        <TextBlock Text="Дата народження" Margin="0,8,0,2" />
        <DatePicker SelectedDate="{Binding BirthDate}" />
        <TextBlock Text="{Binding BirthDateError}" Foreground="Red" TextWrapping="Wrap" />

        <TextBlock Text="{Binding GeneralError}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap" Margin="0,8,0,0" />

        <Button Content="Зберегти"
                Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButton}"
                Margin="0,16,0,0" />
    </StackPanel>
</Window>