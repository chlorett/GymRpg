<Window x:Class="MyApp.Wpf.Views.PersonalRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:PersonalRecordsViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Історія тренувань та особисті рекорди (PR / 1RM) — PulseForge"
        Height="740" Width="1100"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.1*" />
            <RowDefinition Height="1.3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Історія тренувань та рекорди (PR / 1RM)"
                       Style="{StaticResource FormTitle}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Аналіз особистих силових рекордів по кожній вправі, розрахунковий 1RM (формула Еплі) та керування журналом виконаних підходів."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" />
        </StackPanel>

        <!-- Фільтри -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Вправа" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Exercises}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding SelectedExerciseId, Mode=TwoWay}"
                              Style="{StaticResource FieldComboBox}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Статус чесності записів" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding HonestyFilterOptions}"
                              SelectedItem="{Binding SelectedHonestyFilter, Mode=TwoWay}"
                              Style="{StaticResource FieldComboBox}" />
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Скинути"
                        Command="{Binding ResetFiltersCommand}"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Bottom"
                        MinHeight="36"
                        Padding="14,6"
                        Margin="0,0,8,0" />

                <Button Grid.Column="4"
                        Content="Оновити"
                        Command="{Binding LoadOverviewCommand}"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        MinHeight="36"
                        Padding="18,6" />
            </Grid>
        </Border>

        <!-- Картки статистики -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Усього записів у журналі" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding TotalWorkoutsLogged}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="3,0">
                <StackPanel>
                    <TextBlock Text="Вправ із рекордами" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding ExercisesWithRecordsCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="3,0">
                <StackPanel>
                    <TextBlock Text="Абсолютний рекорд 1RM" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding BestOneRepMaxText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Коронна вправа" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding BestExerciseName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Таблиця 1: Особисті рекорди по вправах -->
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Top"
                       Text="Особисті рекорди по вправах (PR та розрахунковий 1RM — тільки чесні записи)"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,6" />
            <DataGrid ItemsSource="{Binding PersonalRecords}"
                      Style="{StaticResource AppDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Вправа" Binding="{Binding ExerciseName}" Width="*" />
                    <DataGridTextColumn Header="Макс. вага (кг)" Binding="{Binding MaxWeightKg, StringFormat={}{0:0.#}}" Width="140" />
                    <DataGridTextColumn Header="Розрахунковий 1RM (кг)" Binding="{Binding EstimatedOneRepMaxKg, StringFormat={}{0:0.#}}" Width="175" />
                    <DataGridTextColumn Header="Макс. тоннаж (кг)" Binding="{Binding MaxVolumeKg, StringFormat={}{0:0.#}}" Width="155" />
                    <DataGridTextColumn Header="Тренувань" Binding="{Binding TotalWorkoutsCount}" Width="105" />
                    <DataGridTextColumn Header="Дата рекорду" Binding="{Binding AchievedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Таблиця 2: Повний журнал виконаних тренувань -->
        <DockPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Top"
                       Text="Журнал виконаних тренувань (оберіть рядок, щоб видалити помилковий запис)"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,6" />
            <DataGrid ItemsSource="{Binding WorkoutLogs}"
                      SelectedItem="{Binding SelectedLogEntry, Mode=TwoWay}"
                      Style="{StaticResource AppDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="135" />
                    <DataGridTextColumn Header="Вправа" Binding="{Binding ExerciseName}" Width="180" />
                    <DataGridTextColumn Header="Підходи" Binding="{Binding SetsCount}" Width="75" />
                    <DataGridTextColumn Header="Повтори" Binding="{Binding TotalReps}" Width="80" />
                    <DataGridTextColumn Header="Найкраща вага" Binding="{Binding BestWeightKg, StringFormat={}{0:0.#} кг}" Width="115" />
                    <DataGridTextColumn Header="1RM (Еплі)" Binding="{Binding BestEstimatedOneRepMaxKg, StringFormat={}{0:0.#} кг}" Width="105" />
                    <DataGridTextColumn Header="XP" Binding="{Binding XpEarned}" Width="65" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="95" />
                    <DataGridTextColumn Header="Деталі підходів" Binding="{Binding SetsSummaryText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Нижня панель керування журналом -->
        <Border Grid.Row="5"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Видалити вибраний запис із журналу"
                        Command="{Binding DeleteSelectedRecordCommand}"
                        IsEnabled="{Binding HasSelectedLogEntry}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="18,8" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
