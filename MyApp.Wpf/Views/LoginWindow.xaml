<Window x:Class="MyApp.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:LoginViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Вхід у систему — PulseForge" Height="420" Width="440"
        MinHeight="380" MinWidth="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Вхід у систему"
                   Margin="0,0,0,8"
                   Style="{StaticResource FormTitle}" />

        <TextBlock Text="Тестовий акаунт: athlete@gym.com (пароль: 123456)"
                   Foreground="#718096"
                   FontSize="12"
                   Margin="0,0,0,16" />

        <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4,0,12"
                 Style="{StaticResource FieldInput}" />

        <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordInput"
                     PasswordChanged="OnPasswordChanged"
                     Margin="0,4,0,16"
                     Style="{StaticResource FieldInput}" />

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="Crimson"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldError}">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Button Content="Увійти"
                Command="{Binding LoginCommand}"
                IsDefault="True"
                Padding="16,10"
                FontSize="15"
                FontWeight="Bold"
                Style="{StaticResource PrimaryButton}" />

        <Button Content="Немає акаунту? Зареєструватися"
                Click="OnOpenRegisterClick"
                Margin="0,10,0,0"
                Style="{StaticResource SecondaryButton}" />
    </StackPanel>
</Window>
