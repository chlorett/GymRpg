<Window x:Class="MyApp.Wpf.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:RegisterViewModel}"
        Title="Реєстрація" Height="700" Width="560"
        MinHeight="520" MinWidth="460"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Реєстрація"
                       Margin="0,0,0,16"
                       Style="{StaticResource FormTitle}" />

            <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,4,0,12"
                     Style="{StaticResource FieldInput}" />

            <TextBlock Text="Ім'я користувача" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,4,0,12"
                     Style="{StaticResource FieldInput}" />

            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordInput"
                         PasswordChanged="OnPasswordChanged"
                         Margin="0,4,0,12"
                         Style="{StaticResource FieldInput}" />

            <TextBlock Text="Підтвердіть пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ConfirmPasswordInput"
                         PasswordChanged="OnConfirmPasswordChanged"
                         Margin="0,4,0,12"
                         Style="{StaticResource FieldInput}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Вага, кг" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0"
                             Style="{StaticResource FieldInput}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Зріст, см" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding HeightCm, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0"
                             Style="{StaticResource FieldInput}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Дата народження" Style="{StaticResource FieldLabel}" />
            <DatePicker SelectedDate="{Binding BirthDate}"
                        Margin="0,4,0,16"
                        Style="{StaticResource FieldInput}" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Crimson"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldError}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="Зареєструватися"
                    Command="{Binding RegisterCommand}"
                    IsDefault="True"
                    Padding="16,10"
                    FontSize="15"
                    FontWeight="Bold"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </ScrollViewer>
</Window>
