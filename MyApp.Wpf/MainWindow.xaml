<Window x:Class="MyApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="PulseForge" Height="494" Width="1040"
        Icon="/Resources/Icon/logo.png"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Верхня панель ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Icon/logo.png" Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="PulseForge" Style="{StaticResource FormTitle}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- x:Name залишаємо, його використовує code-behind -->
                <TextBlock Grid.Column="1" x:Name="ActiveUserText"
                           Text="Поточний атлет: athlete (ID: 1) | Тренер: coach_ivan (ID: 2)"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Margin="24,0,16,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Вхід" Style="{StaticResource SecondaryButton}"
                            MinHeight="34" Padding="18,4" Click="OnLoginClick" />
                    <Button Content="Реєстрація" Style="{StaticResource SecondaryButton}"
                            MinHeight="34" Padding="18,4" Margin="8,0,0,0" Click="OnRegisterClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Контент ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,67,0,58" Grid.RowSpan="2">
            <StackPanel Margin="32,24" MaxWidth="1000">

                <!-- Головна дія -->
                <Border Background="{StaticResource AccentBrush}"
                        CornerRadius="12" Padding="28,24" Margin="8,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Готовий до тренування?"
                                       FontSize="22" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Занотуй підходи та дивись, як росте твій рівень."
                                       FontSize="13" Foreground="White" Opacity="0.85"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Нове тренування"
                                Style="{StaticResource SecondaryButton}"
                                FontWeight="SemiBold" Padding="26,8" MinHeight="44"
                                VerticalAlignment="Center"
                                Click="OnTrackWorkoutClick" />
                    </Grid>
                </Border>

                <!-- Картки розділів -->
                <UniformGrid Columns="3">

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Тренування" Style="{StaticResource CardTitle}" />
                            <Button Content="Каталог вправ" Style="{StaticResource MenuItemButton}"
                                    Click="OnExerciseCatalogClick" />
                            <Button Content="Шаблон тренування" Style="{StaticResource MenuItemButton}"
                                    Click="OnCreateTemplateClick" />
                            <Button Content="Мої шаблони тренувань" Style="{StaticResource MenuItemButton}"
                                    Click="OnManageTemplatesClick" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Прогрес" Style="{StaticResource CardTitle}" />
                            <Button Content="Мій прогрес (RPG)" Style="{StaticResource MenuItemButton}"
                                    Click="OnUserProgressClick" />
                            <Button Content="Лідерборд (Рейтинг)" Style="{StaticResource MenuItemButton}"
                                    Click="OnLeaderboardClick" />
                            <Button Content="Медалі та досягнення" Style="{StaticResource MenuItemButton}"
                                    Click="OnMedalsClick" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Акаунт" Style="{StaticResource CardTitle}" />
                            <Button Content="Профіль" Style="{StaticResource MenuItemButton}"
                                    Click="OnProfileClick" />
                            <Button Content="Змінити пароль" Style="{StaticResource MenuItemButton}"
                                    Click="OnChangePasswordClick" />
                            <Button Content="Мій зал та дивізіон" Style="{StaticResource MenuItemButton}"
                                    Click="OnAffiliationClick" />
                        </StackPanel>
                    </Border>

                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
