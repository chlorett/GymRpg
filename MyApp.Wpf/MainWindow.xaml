<Window x:Class="MyApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseForge" Height="320" Width="420"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="PulseForge" Style="{StaticResource FormTitle}" />
        <Button Content="Реєстрація" Margin="0,12,0,0" Padding="8"
                Style="{StaticResource PrimaryButton}" Click="OnRegisterClick" />
        <Button Content="Нове тренування" Margin="0,12,0,0" Padding="8"
                Style="{StaticResource PrimaryButton}" Click="OnTrackWorkoutClick" />
        <Button Content="Шаблон тренування" Margin="0,12,0,0" Padding="8"
                Style="{StaticResource PrimaryButton}" Click="OnCreateTemplateClick" />
    </StackPanel>
</Window>
