<Window x:Class="MyApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="PulseForge" Height="650" Width="440"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="PulseForge" Style="{StaticResource FormTitle}" />
        <TextBlock x:Name="ActiveUserText"
                   Text="Поточний атлет: athlete (ID: 1) | Тренер: coach_ivan (ID: 2)"
                   HorizontalAlignment="Center"
                   Foreground="#718096"
                   FontSize="12"
                   Margin="0,8,0,8" />
        <Button Content="Вхід у систему" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnLoginClick" />
        <Button Content="Реєстрація" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnRegisterClick" />
        <Button Content="Нове тренування" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnTrackWorkoutClick" />
        <Button Content="Каталог вправ" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnExerciseCatalogClick" />
        <Button Content="Мій прогрес (RPG)" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnUserProgressClick" />
        <Button Content="Лідерборд (Рейтинг)" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnLeaderboardClick" />
        <Button Content="Медалі та досягнення" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnMedalsClick" />
        <Button Content="Шаблон тренування" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnCreateTemplateClick" />
        <Button Content="Профіль" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnProfileClick" />
        <Button Content="Змінити пароль" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnChangePasswordClick" />
    </StackPanel>
</Window>
