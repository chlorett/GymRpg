+<Window x:Class="MyApp.Wpf.Views.DivisionQualificationWindow"
+        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
+        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
+        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
+        xmlns:viewModels="clr-namespace:MyApp.Wpf.ViewModels"
+        mc:Ignorable="d"
+        d:DataContext="{d:DesignInstance Type=viewModels:DivisionQualificationViewModel}"
+        Style="{StaticResource AppWindow}"
+        Title="Дивізіони та кваліфікація — PulseForge"
+        Height="760" Width="1040"
+        MinHeight="640" MinWidth="900"
+        WindowStartupLocation="CenterScreen">
+    <Window.Resources>
+        <Style x:Key="CollapsedWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource FieldError}">
+            <Style.Triggers>
+                <Trigger Property="Text" Value="">
+                    <Setter Property="Visibility" Value="Collapsed" />
+                </Trigger>
+                <Trigger Property="Text" Value="{x:Null}">
+                    <Setter Property="Visibility" Value="Collapsed" />
+                </Trigger>
+            </Style.Triggers>
+        </Style>
+        <Style x:Key="SuccessText" TargetType="TextBlock" BasedOn="{StaticResource CollapsedWhenEmpty}">
+            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
+        </Style>
+    </Window.Resources>
+    <Grid Margin="24">
+        <Grid.RowDefinitions>
+            <RowDefinition Height="Auto" />
+            <RowDefinition Height="Auto" />
+            <RowDefinition Height="*" />
+            <RowDefinition Height="Auto" />
+        </Grid.RowDefinitions>
+
+        <!-- Заголовок -->
+        <TextBlock Grid.Row="0"
+                   Text="Дивізіони та кваліфікація"
+                   Style="{StaticResource FormTitle}"
+                   Margin="0,0,0,12" />
+
+        <!-- Поточний статус і перехід у вищу лігу -->
+        <Border Grid.Row="1"
+                Style="{StaticResource CardBorder}"
+                Margin="0,0,0,12">
+            <Grid>
+                <Grid.ColumnDefinitions>
+                    <ColumnDefinition Width="*" />
+                    <ColumnDefinition Width="Auto" />
+                </Grid.ColumnDefinitions>
+
+                <StackPanel Grid.Column="0" Margin="0,0,16,0">
+                    <TextBlock Text="Мій дивізіон" Style="{StaticResource FieldLabel}" />
+                    <TextBlock Text="{Binding CurrentDivisionText}"
+                               FontSize="22"
+                               FontWeight="Bold"
+                               Foreground="{StaticResource AccentBrush}" />
+                    <TextBlock Text="{Binding XpText}"
+                               Foreground="{StaticResource TextSecondaryBrush}"
+                               Margin="0,2,0,8" />
+                    <ProgressBar Minimum="0"
+                                 Maximum="100"
+                                 Height="16"
+                                 Value="{Binding ProgressPercent, Mode=OneWay}"
+                                 Foreground="{StaticResource AccentBrush}" />
+                    <TextBlock Text="{Binding ProgressText}"
+                               Foreground="{StaticResource TextPrimaryBrush}"
+                               Margin="0,6,0,0" />
+                </StackPanel>
+
+                <Button Grid.Column="1"
+                        Content="Підвищити дивізіон"
+                        Command="{Binding PromoteCommand}"
+                        VerticalAlignment="Center"
+                        Padding="20,10"
+                        Style="{StaticResource PrimaryButton}" />
+            </Grid>
+        </Border>
+
+        <!-- Вимоги дивізіонів і таблиця лідерів -->
+        <Grid Grid.Row="2">
+            <Grid.ColumnDefinitions>
+                <ColumnDefinition Width="*" />
+                <ColumnDefinition Width="16" />
+                <ColumnDefinition Width="1.4*" />
+            </Grid.ColumnDefinitions>
+
+            <GroupBox Grid.Column="0"
+                      Header="Кваліфікаційні вимоги"
+                      Padding="8">
+                <DataGrid ItemsSource="{Binding Requirements}"
+                          Style="{StaticResource AppDataGrid}"
+                          AutoGenerateColumns="False"
+                          IsReadOnly="True"
+                          CanUserAddRows="False"
+                          CanUserDeleteRows="False"
+                          FontSize="13">
+                    <DataGrid.Columns>
+                        <DataGridTextColumn Header="Дивізіон" Binding="{Binding Name}" Width="*" />
+                        <DataGridTextColumn Header="Мін. XP" Binding="{Binding MinXp}" Width="80" />
+                        <DataGridTextColumn Header="Мін. рівень" Binding="{Binding MinLevel}" Width="90" />
+                        <DataGridCheckBoxColumn Header="Мій" Binding="{Binding IsCurrent, Mode=OneWay}" Width="50" />
+                        <DataGridCheckBoxColumn Header="Досягнуто" Binding="{Binding IsReached, Mode=OneWay}" Width="90" />
+                    </DataGrid.Columns>
+                </DataGrid>
+            </GroupBox>
+
+            <GroupBox Grid.Column="2"
+                      Padding="8">
+                <GroupBox.Header>
+                    <TextBlock Text="{Binding StandingsTitle}" />
+                </GroupBox.Header>
+                <Grid>
+                    <Grid.RowDefinitions>
+                        <RowDefinition Height="Auto" />
+                        <RowDefinition Height="*" />
+                    </Grid.RowDefinitions>
+
+                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
+                        <TextBlock Text="Показати дивізіон" Style="{StaticResource FieldLabel}" />
+                        <ComboBox ItemsSource="{Binding Requirements}"
+                                  SelectedItem="{Binding SelectedDivision}"
+                                  DisplayMemberPath="Name"
+                                  Style="{StaticResource FieldComboBox}" />
+                    </StackPanel>
+
+                    <DataGrid Grid.Row="1"
+                              ItemsSource="{Binding Standings}"
+                              Style="{StaticResource AppDataGrid}"
+                              AutoGenerateColumns="False"
+                              IsReadOnly="True"
+                              CanUserAddRows="False"
+                              CanUserDeleteRows="False"
+                              FontSize="13">
+                        <DataGrid.Columns>
+                            <DataGridTextColumn Header="Місце" Binding="{Binding Rank, StringFormat=#{0}}" Width="70" />
+                            <DataGridTextColumn Header="Атлет" Binding="{Binding Username}" Width="1.2*" />
+                            <DataGridTextColumn Header="Спортзал" Binding="{Binding GymName}" Width="1.4*" />
+                            <DataGridTextColumn Header="XP" Binding="{Binding TotalXp}" Width="80" />
+                            <DataGridTextColumn Header="Рівень" Binding="{Binding Level}" Width="70" />
+                        </DataGrid.Columns>
+                    </DataGrid>
+                </Grid>
+            </GroupBox>
+        </Grid>
+
+        <!-- Повідомлення та кнопки -->
+        <Grid Grid.Row="3" Margin="0,12,0,0">
+            <Grid.ColumnDefinitions>
+                <ColumnDefinition Width="*" />
+                <ColumnDefinition Width="Auto" />
+            </Grid.ColumnDefinitions>
+
+            <StackPanel Grid.Column="0" VerticalAlignment="Center">
+                <TextBlock Text="{Binding ErrorMessage}"
+                           FontWeight="SemiBold"
+                           TextWrapping="Wrap"
+                           Style="{StaticResource CollapsedWhenEmpty}" />
+                <TextBlock Text="{Binding StatusMessage}"
+                           FontWeight="SemiBold"
+                           TextWrapping="Wrap"
+                           Style="{StaticResource SuccessText}" />
+            </StackPanel>
+
+            <StackPanel Grid.Column="1" Orientation="Horizontal">
+                <Button Content="Оновити"
+                        Command="{Binding RefreshCommand}"
+                        Style="{StaticResource SecondaryButton}"
+                        Padding="16,8"
+                        Margin="0,0,10,0" />
+                <Button Content="Закрити"
+                        Click="OnCloseClick"
+                        Style="{StaticResource PrimaryButton}"
+                        Padding="20,8" />
+            </StackPanel>
+        </Grid>
+    </Grid>
+</Window>
